# Copy to .env (or .env.local) and fill in real values. Never commit real secrets.

# --- Required ---------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/pns?schema=public"

# Secret used to sign member and admin JWT cookies. Use a long random string
# (e.g. `openssl rand -base64 48`). The app refuses to start in production
# without it.
JWT_SECRET=""

# --- Public URLs ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Comma-separated list of origins allowed to call the public registration API.
# Leave empty to allow any origin (development only).
CORS_ALLOW_ORIGIN=""

# --- Email (membership confirmation) ---------------------------------------
# When SMTP_USER / SMTP_PASS are empty the mailer is disabled and registration
# still succeeds (a warning is logged instead of sending).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- File storage -----------------------------------------------------------
# Local development stores uploads under public/uploads.
# On Vercel (or any read-only filesystem) set a Vercel Blob token instead.
BLOB_READ_WRITE_TOKEN=""
BLOB_URL="https://blob.vercel-storage.com"
BLOB_UPLOAD_PREFIX="pns-membership"
BLOB_PREVIEW_PREFIX="pns-previews"
BLOB_ACCESS_LEVEL="public"

# --- Seed script (npm run db:seed) -----------------------------------------
ADMIN_EMAIL="admin@pns.com"
ADMIN_PASSWORD="ChangeMe!"
ADMIN_NAME="Administrator"
ADMIN_PHONE="0000000000"
ADMIN_TITLE="Admin"
