// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Enums (top-level, outside any model) ----
enum OwnershipProofType {
  LD_TAX_RECEIPT
  MUTATION_PAPER
  BDS_KHATIAN
}

enum PaymentMethod {
  BKASH
  BANK
}

// Management roles
enum ManagementRole {
  ADMIN
  EDITOR
  VIEWER
}

// User status
enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---- Models ----
model User {
  id Int @id @default(autoincrement())

  // Plot info
  sectorNumber String
  roadNumber   String
  plotNumber   String
  plotSize     String
  plotId       String @unique @default(cuid())

  // Ownership proof
  ownershipProofType OwnershipProofType
  ownershipProofFile String? // store file path/URL

  // Owner info
  ownerNameEnglish String
  ownerNameBangla  String
  contactNumber    String
  nidNumber        String
  presentAddress   String
  permanentAddress String
  email            String  @unique
  ownerPhoto       String? // store file path/URL

  // ✅ New field (store hashed password)
  password String
  status   UserStatus @default(PENDING)

  // Payment
  paymentMethod         PaymentMethod
  bkashTransactionId    String?
  bkashAccountNumber    String?
  bankAccountNumberFrom String?
  paymentReceipt        String? // store file path/URL
  membershipFee         Int           @default(1020)
  agreeDataUse          Boolean       @default(false)

  // Meta
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  vouchers Voucher[]
}

model Post {
  id         Int     @id @default(autoincrement())
  title      String
  content    String?
  published  Boolean @default(false)
  coverImage String? // optional file path/URL

  // Relations
  authorId Int
  author   ManagementUser @relation(fields: [authorId], references: [id])

  // Meta
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId, createdAt])
}

// Management users (dashboard staff). Access comes from roleRef; `role` is the legacy enum kept in sync.
model ManagementUser {
  id       Int            @id @default(autoincrement())
  photoUrl String?
  name     String
  phone    String
  address  String?
  role     ManagementRole @default(VIEWER)
  email    String         @unique
  password String
  title    String?
  created  DateTime       @default(now())

  // Role-based access
  roleId      Int?
  roleRef     Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  // Relations
  posts           Post[]
  vouchersCreated Voucher[] @relation("VoucherCreatedBy")
  vouchersVoided  Voucher[] @relation("VoucherVoidedBy")

  @@index([name, email])
  @@index([roleId])
}

/// Staff role: a named list of permission keys (lib/shared/permissions.ts). "*" = full access.
model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users ManagementUser[]
}

model PreviewDocument {
  id        Int      @id @default(autoincrement())
  title     String?
  fileUrl   String
  createdAt DateTime @default(now())
}

/// Key/value store for admin-editable site configuration.
/// `key` is a section name (site | payment | registration); `value` is that
/// section's JSON object. Defaults live in lib/shared/settings.ts.
model SiteSetting {
  key         String   @id
  value       Json
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---- Accounting ----
enum FundAccountType {
  CASH
  BANK
  MOBILE_BANKING
}

enum LedgerHeadType {
  INCOME
  EXPENSE
}

enum VoucherType {
  INCOME
  EXPENSE
  TRANSFER
}

enum VoucherStatus {
  POSTED
  VOID
}

// Where money sits: cash box, bank account, bKash wallet.
model FundAccount {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  type           FundAccountType
  accountNumber  String?
  institution    String?
  branch         String?
  openingBalance Decimal         @default(0) @db.Decimal(14, 2)
  isActive       Boolean         @default(true)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  vouchers         Voucher[] @relation("VoucherAccount")
  incomingTransfer Voucher[] @relation("VoucherToAccount")
}

// Income / expense categories (chart of accounts heads).
model LedgerHead {
  id          Int            @id @default(autoincrement())
  name        String
  code        String?        @unique
  type        LedgerHeadType
  description String?
  isActive    Boolean        @default(true)
  isSystem    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  vouchers Voucher[]

  @@unique([type, name])
}

// One money movement. INCOME/EXPENSE use headId + accountId; TRANSFER moves accountId -> toAccountId.
model Voucher {
  id            Int           @id @default(autoincrement())
  voucherNo     String        @unique
  type          VoucherType
  status        VoucherStatus @default(POSTED)
  date          DateTime
  amount        Decimal       @db.Decimal(14, 2)
  headId        Int?
  head          LedgerHead?   @relation(fields: [headId], references: [id])
  accountId     Int
  account       FundAccount   @relation("VoucherAccount", fields: [accountId], references: [id])
  toAccountId   Int?
  toAccount     FundAccount?  @relation("VoucherToAccount", fields: [toAccountId], references: [id])
  partyName     String?
  reference     String?
  description   String?
  attachmentUrl String?
  memberId      Int?
  member        User?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
  createdById   Int?
  createdBy     ManagementUser? @relation("VoucherCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  voidReason    String?
  voidedAt      DateTime?
  voidedById    Int?
  voidedBy      ManagementUser? @relation("VoucherVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([date])
  @@index([type, date])
  @@index([headId])
  @@index([accountId])
  @@index([toAccountId])
  @@index([memberId])
}
