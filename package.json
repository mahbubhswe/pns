{
  "name": "pns",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node scripts/seed-admin.js",
    "seed:admin": "node scripts/seed-admin.js",
    "migrate:memberships": "node scripts/migrate-memberships.js",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node scripts/seed-admin.js"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "@mui/material-nextjs": "^7.3.10",
    "@mui/x-charts": "^7.29.1",
    "@mui/x-data-grid": "^7.29.9",
    "@mui/x-date-pickers": "^8.10.0",
    "@prisma/client": "^6.15.0",
    "@react-pdf/renderer": "^4.3.1",
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.2",
    "dayjs": "^1.11.13",
    "framer-motion": "^12.18.1",
    "jsonwebtoken": "^9.0.2",
    "next": "16.0.10",
    "nodemailer": "^7.0.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sweetalert2": "^11.19.1",
    "swr": "^2.3.6",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "prettier": "^3.3.3",
    "prisma": "^6.15.0",
    "typescript": "^5"
  }
}
